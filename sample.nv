struct Point {
    x,
    y,

    move: |self, dx, dy| {
        self.x = self.x + dx;
        self.y = self.y + dy;
    }
}

let A = matrix([
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]);

let transform = |x| x * 2;

let B = A[0..2, 1..3] * 2;

let p = Point(
    transform(B[0, 0]),
    transform(B[1, 1])
);

p.move(1, 1);

welch_t(
    [p.x, p.y, 5, 6, 7],
    [8, 9, 10, 11, 12]
)


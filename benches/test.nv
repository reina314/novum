import math

// define Perceptron class
pub class Perceptron {
    weights = [0.0],
    bias = 0.0,
    learning_rate,
    epochs,

    init = |self, input_dim, learning_rate, epochs| { 
        self.weights *= input_dim
        self.learning_rate = learning_rate
        self.epochs = epochs
    },

    predict = |self, x| {
        let sum =
            zip(self.weights, x)
            .map(|(w, xi)| w * xi)
            .sum()

        if (sum + self.bias) >= 0 { 1 }
        else { 0 } 
    },

    fit = |self, X, y| {
        for epoch in range(self.epochs) {
            total_error = 0

            for (xi, target) in zip(X, y) {
                prediction = self.predict(xi)
                error = target - prediction

                if error != 0 {
                    for (i, (w, x_val)) 
                        in enumerate(zip(self.weights, xi)) 
                    {
                        self.weights[i] = 
                            w + self.learning_rate * error * x_val
                    }

                    self.bias += self.learning_rate * error
                    total_error += math.abs(error)
                }
            }

            if total_error == 0 {
                print("Epochs: "+ (epoch + 1) + ", converged")
                break
            }
        }
    }
}


// fitting and prediction
print("\n==AND gate=======================")

X_and = [[0, 0], [0, 1], [1, 0], [1, 1]]
y_and = [0, 0, 0, 1]

model_and = Perceptron(
                input_dim = 2, 
                learning_rate = 0.005, 
                epochs = 20,
            )
model_and.fit(X_and, y_and)

print("Weights after fitting: " + model_and.weights)
print("Bias after fitting: " + model_and.bias)

print("\nPrediction: ")
for (x, y) in zip(X_and, y_and) {
    print(x)
    print(y)
    print(model_and.predict(x))
    
    //print(
    //    "\t" + x + " -> " + model_and.predict(x) + "   Answer: " + y
    //)
}


print("\n==OR gate=======================")
X_or = [[0, 0], [0, 1], [1, 0], [1, 1]]
y_or = [0, 1, 1, 1]

model_or = Perceptron(
                input_dim = 2, 
                learning_rate = 0.005, 
                epochs = 20,
            )
model_or.fit(X_or, y_or)

print("Weights after fitting: " + model_or.weights)
print("Bias after fitting: " + model_or.bias)

print("\nPrediction: ")
for (x, y) in zip(X_or, y_or) {
    print(
        "\t" + x + " -> " + model_or.predict(x) + "   Answer: " + y
    )
}

// Example Output
//
// ==AND gate=======================
// Epochs: 6, converged
// Weights after fitting: [0.01, 0.005]
// Bias after fitting: -0.015

// Prediction:
//         [0, 0] -> 0   Answer: 0
//         [0, 1] -> 0   Answer: 0
//         [1, 0] -> 0   Answer: 0
//         [1, 1] -> 1   Answer: 1

// ==OR gate=======================
// Epochs: 4, converged
// Weights after fitting: [0.005, 0.005]
// Bias after fitting: -0.005

// Prediction:
//         [0, 0] -> 0   Answer: 0
//         [0, 1] -> 1   Answer: 1
//         [1, 0] -> 1   Answer: 1
//         [1, 1] -> 1   Answer: 1
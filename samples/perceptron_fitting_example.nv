import perceptron_example as perceptron

// fitting and prediction
print("\n==AND gate=======================")

X_and = [[0, 0], [0, 1], [1, 0], [1, 1]]
y_and = [0, 0, 0, 1]

model_and = perceptron.Perceptron(2, 0.005, 20)
model_and.fit(X_and, y_and)

print("Weights after fitting: " + model_and.weights)
print("Bias after fitting: " + model_and.bias)

print("\nPrediction: ")
for (x, y) in zip(X_and, y_and) {
    print(
        "\t" + x + " -> " + model_and.predict(x) + "   Answer: " + y
    )
}


print("\n==OR gate=======================")
X_or = [[0, 0], [0, 1], [1, 0], [1, 1]]
y_or = [0, 1, 1, 1]

model_or = perceptron.Perceptron(2, 0.005, 20)
model_or.fit(X_or, y_or)

print("Weights after fitting: " + model_or.weights)
print("Bias after fitting: " + model_or.bias)

print("\nPrediction: ")
for (x, y) in zip(X_or, y_or) {
    print(
        "\t" + x + " -> " + model_or.predict(x) + "   Answer: " + y
    )
}

// Example Output
//
// ==AND gate=======================
// Epochs: 6, converged
// Weights after fitting: [0.01, 0.005]
// Bias after fitting: -0.015

// Prediction:
//         [0, 0] -> 0   Answer: 0
//         [0, 1] -> 0   Answer: 0
//         [1, 0] -> 0   Answer: 0
//         [1, 1] -> 1   Answer: 1

// ==OR gate=======================
// Epochs: 4, converged
// Weights after fitting: [0.005, 0.005]
// Bias after fitting: -0.005

// Prediction:
//         [0, 0] -> 0   Answer: 0
//         [0, 1] -> 1   Answer: 1
//         [1, 0] -> 1   Answer: 1
//         [1, 1] -> 1   Answer: 1